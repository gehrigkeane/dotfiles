// Default layout — single full-screen pane with native tab-bar + status-bar.
// Declared explicitly so it's chezmoi-trackable instead of relying on the
// built-in default. Mirrors `zellij`'s OOTB experience, theme-driven by
// `theme "everforest-dark"` in config.kdl.
layout {
    pane size=1 borderless=true {
        plugin location="zellij:tab-bar" {
            hide_swap_layout_indication "true"
        }
    }
    pane
    pane size=2 borderless=true {
        plugin location="zellij:status-bar"
    }
}
