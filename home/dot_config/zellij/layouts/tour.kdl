// Tour layout — presenterm on top, demo shell below.
// Invoke from ~/dev/slides/zellij-tour with: zellij --layout tour
//
// The recursion (zellij demoed inside zellij) is intentional — viewers see
// the tool while hearing about it. Switch focus with Alt+j / Alt+k.
layout {
    pane split_direction="horizontal" {
        // Top 60%: slide deck
        pane size="60%" name="slides" {
            command "presenterm"
            args "tour.md"
        }
        // Bottom 40%: live demo surface
        pane size="40%" name="demo"
    }

    pane size=1 borderless=true {
        plugin location="zellij:tab-bar"
    }
    pane size=2 borderless=true {
        plugin location="zjstatus"
    }
}
